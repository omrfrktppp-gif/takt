# Google Search Console — HTML etiketi content değeri (tırnaksız)
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools — msvalidate.01 content değeri
BING_MSVALIDATE=

# IndexNow API koruması — /api/indexnow POST için Bearer token
INDEXNOW_API_SECRET=

# IndexNow anahtarı — varsayılan projede tanımlı; değiştirmeyin
# INDEXNOW_KEY=a8f3c2e1b9d0475682acf1e03b4d1597

# Google Tag Manager container ID
NEXT_PUBLIC_GTM_ID=GTM-PB25P347

# Web3Forms access key kodda sabit (lib/web3forms.tsx) — iletişim formu; env gerekmez

# İhtiyaç analizi formu — Resend e-posta raporu
# Resend panelinden API key alın; re_xxxxxxxxx yerine gerçek anahtarınızı yazın.
RESEND_API_KEY=re_xxxxxxxxx
# İlk test: onboarding@resend.dev (sadece kayıtlı e-postaya gider)
# Canlı: takt.tr domain doğrulandıktan sonra → Takt <noreply@takt.tr>
RESEND_FROM=onboarding@resend.dev
RESEND_TO=info@takt.tr

# Faz 2 — WhatsApp Cloud API bildirimi (opsiyonel)
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_NOTIFY_TO=
